import java.util.Scanner;

public class CollatzSequence {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Digite um número inteiro positivo: ");
        int n = sc.hasNextInt() ? sc.nextInt() : 0;

        if (n < 1) {
            System.out.println("Erro: O número deve ser um inteiro positivo.");
        } else {
            processarCollatz(n);
        }
        sc.close();
    }

    // Método que resolve os dois requisitos de uma vez (sequência e soma)
    public static void processarCollatz(int n) {
        long soma = 0;
        String resultado = "";

        System.out.print("Sequência de Collatz: ");
        
        while (n != 1) {
            System.out.print(n + " + ");
            soma += n;
            n = (n % 2 == 0) ? n / 2 : (n * 3) + 1;
        }
        
        soma += 1; // Adiciona o termo final 1
        System.out.println("1");
        System.out.println("Soma dos termos: " + soma);
    }
}