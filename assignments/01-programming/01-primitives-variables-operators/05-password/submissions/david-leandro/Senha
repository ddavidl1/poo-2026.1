import java.util.Scanner;

public class FortalecerSenha {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.print("Digite a senha: ");
        String s = scanner.next();

        System.out.println("Senha fortalecida: " + fortalecerSenha(s));
        scanner.close();
    }

    public static int calcularTempoDigitacao(String s) {
        if (s.isEmpty()) return 0;
        int tempo = 2; // Primeiro caractere
        for (int i = 1; i < s.length(); i++) {
            if (s.charAt(i) == s.charAt(i - 1)) tempo += 1;
            else tempo += 2;
        }
        return tempo;
    }

    public static String fortalecerSenha(String s) {
        String melhorSenha = "";
        int maxTempo = -1;

        // Tenta inserir cada letra de 'a' a 'z' em cada posição possível
        for (int i = 0; i <= s.length(); i++) {
            for (char c = 'a'; c <= 'z'; c++) {
                String novaSenha = s.substring(0, i) + c + s.substring(i);
                int tempo = calcularTempoDigitacao(novaSenha);
                if (tempo > maxTempo) {
                    maxTempo = tempo;
                    melhorSenha = novaSenha;
                }
            }
        }
        return melhorSenha;
    }
}